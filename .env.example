# Set to "false" to connect to a real Firebase project instead of the local emulators.
VITE_USE_FIREBASE_EMULATOR=true

# Only needed when VITE_USE_FIREBASE_EMULATOR=false — paste these from your
# Firebase console: Project settings > General > Your apps > SDK setup and config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Image hosting (Cloudinary) — used instead of Firebase Storage since Cloud
# Storage for Firebase now requires the Blaze billing plan. Get these from
# your Cloudinary dashboard (Cloud name) and Settings > Upload > Upload
# presets (an UNSIGNED preset you create).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
